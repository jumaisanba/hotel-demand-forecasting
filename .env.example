# ---- PostgreSQL ----
DB_USER=your_db_user
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432
DB_NAME=hotel_forecasting

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

OUTBOX_PUBLISH_INTERVAL_SEC=2
OUTBOX_BATCH_SIZE=100

# ---- Services ----
ROUTER_URL=http://router:8000
PREDICTION_URL=http://prediction:8000
AUTH_URL=http://auth:8000
BOOKING_URL=http://booking:8000
SCHEDULER_URL=http://scheduler:8000
FRONTEND_URL=http://localhost:8080

# ---- Timeouts ----
AUTH_TIMEOUT_SEC=5

# ---- Auth / Security ----
JWT_SECRET_KEY=change_me
JWT_PUBLIC_KEY=change_me_if_used
JWT_HASH_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440

PASSWORD_HASH_ALGORITHM=bcrypt